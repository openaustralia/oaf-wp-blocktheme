# Local verification / dev artifacts - not part of the theme
.wp-core/
.playwright-mcp/
node_modules/
vendor/
*.log
debug.log

# Handoff / archive artifacts - not part of the theme
*.zip

# Playwright verification screenshots (the theme's own preview is screenshot.png)
v-*.png
oaf-home-full.png
oaf-collection.png
oaf-donate.png
oaf-home-mobile.png

# OS
.DS_Store

# Re-include the block theme's template parts. The global gitignore
# (~/.gitignore_global, from the Python template) ignores any directory named
# parts/ (it belongs to the buildout tool), which silently excludes this theme's
# header/footer template parts and breaks deploys. Keep them tracked here.
!parts/
!parts/*.html
